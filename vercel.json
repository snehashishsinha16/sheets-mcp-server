{
  "rewrites": [
    { "source": "/oauth/callback", "destination": "/api/oauth-callback" },
    { "source": "/login", "destination": "/api/oauth-authorize" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/well-known-auth-server" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/well-known-protected-resource" },
    { "source": "/register", "destination": "/api/oauth-register" },
    { "source": "/authorize", "destination": "/api/oauth-mcp-authorize" },
    { "source": "/token", "destination": "/api/oauth-token" }
  ]
}
